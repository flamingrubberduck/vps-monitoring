# PostgreSQL / TimescaleDB connection URL
# Bundled compose stack (hostname = service name `db`):
DATABASE_URL=postgres://vpsmon:changeme@db:5432/vpsmon

# Local development (TimescaleDB running on your machine):
# DATABASE_URL=postgres://vpsmon:vpsmon@localhost:5432/vpsmon

# External managed PostgreSQL (e.g. Supabase, Neon, Railway):
# DATABASE_URL=postgres://user:pass@db.example.com:5432/vpsmon?sslmode=require

# ── Docker Compose bundled DB credentials ─────────────────────────────────────
POSTGRES_DB=vpsmon
POSTGRES_USER=vpsmon
POSTGRES_PASSWORD=changeme

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-long-random-string-please-change-this

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL where this dashboard is hosted (used by install script)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How many seconds before an agent is considered offline
AGENT_OFFLINE_AFTER_SECONDS=60

# ── Uptime cron secret ─────────────────────────────────────────────────────────
# Protects the /api/uptime/check endpoint. Built-in cron uses this internally.
# Generate with: openssl rand -hex 16
CRON_SECRET=replace-me-with-openssl-rand-hex-16

# Telegram overload alerts: configure in the web UI (Settings → Alerts).
